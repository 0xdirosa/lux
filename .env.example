# Required after Agent Games issues a secret. Never commit .env.
AGENT_GAMES_HMAC_SECRET=
# Public documentation says HMAC over the raw body but omits hash/encoding details.
# Defaults below are conventional guesses; confirm them with Agent Games before registration.
AGENT_GAMES_HMAC_ALGORITHM=sha256
AGENT_GAMES_SIGNATURE_ENCODING=hex
AGENT_GAMES_SIGNATURE_PREFIX=
# Use utf8 unless the platform specifies that the displayed secret must be decoded.
AGENT_GAMES_HMAC_KEY_ENCODING=utf8
AGENT_GAMES_ENDPOINT_URL=https://your-host.example/agent

PORT=3000
HOST=0.0.0.0
STATE_FILE=./data/state.json
MAX_BODY_BYTES=65536
CLOCK_SKEW_SECONDS=60

# Absolute path to a private adapter implementing the contract in ADAPTER.md.
# Without this adapter, signed preflight works but task handling stays not-ready (503).
AGENT_GAMES_ADAPTER=
GATEKEEPER_WASM=./circuits/gatekeeper.wasm
GATEKEEPER_ZKEY=./circuits/gatekeeper_final.zkey
